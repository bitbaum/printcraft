# Supabase (self-hosted on supabase.orangecat.ch, printcraft schema)
NEXT_PUBLIC_SUPABASE_URL=https://supabase.orangecat.ch
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI Providers (add as needed)
# XAI_API_KEY=your_xai_key_here
# REPLICATE_API_TOKEN=your_replicate_token_here
# OPENAI_API_KEY=your_openai_key_here

# Accounts (AccountKit). The accounts database is a host Postgres beside the
# supabase schema (loki accounts-db.conf); provision-db.yml writes both on the
# box. Project data stays in Supabase.
DATABASE_URL=postgres://localhost:5432/printcraft_accounts
# 32+ characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://printcraft.orangecat.ch
# "Continue with OrangeCat": shown only when both are set
# ORANGECAT_OAUTH_CLIENT_ID=
# ORANGECAT_OAUTH_CLIENT_SECRET=
# The shared bitbaum sign-in: shown only when all three are set
# SIGNIN_ISSUER=
# SIGNIN_CLIENT_ID=
# SIGNIN_CLIENT_SECRET=
# Account mail (the emailed sign-in link and recovery are offered only with it)
# RESEND_API_KEY=
